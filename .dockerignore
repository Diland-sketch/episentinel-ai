# Allowlist build context: never send data, secrets, history, venv or frontend.
**
!Dockerfile
!.dockerignore
!src/
!src/episentinel/
!src/episentinel/**/
!src/episentinel/**/*.py
!api/
!api/*.py
!app/
!app/retrospective.py
!scripts/
!scripts/run_retrospective.py
!scripts/profile_render.py
!deploy/
!deploy/*.py
!deploy/panel-manifest.json
!deploy/requirements.in
!deploy/requirements.lock
!docs/
!docs/experiments/
!docs/experiments/*.json
!docs/benchmarks/
!docs/benchmarks/*.json
**/__pycache__
**/*.pyc
**/.env*
**/*.key
**/*.pem
**/credentials*
**/*secret*
